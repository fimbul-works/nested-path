{
  "name": "@fimbul-works/nested-path",
  "description": "Type-safe utilities to get, set, check, and delete nested object and array values with inferred path types and customizable string delimiters",
  "version": "2.0.0",
  "type": "module",
  "private": false,
  "license": "MIT",
  "author": "FimbulWorks <contact@fimbul.works>",
  "homepage": "https://github.com/fimbul-works/nested-path#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fimbul-works/nested-path.git"
  },
  "bugs": {
    "url": "https://github.com/fimbul-works/nested-path/issues"
  },
  "keywords": [
    "typescript",
    "type-safe",
    "type-inference",
    "nested",
    "nested-property",
    "deep-property",
    "object-path",
    "array-path",
    "dot-notation",
    "path-traversal",
    "deep-get",
    "deep-set"
  ],
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "clean": "rm -rf dist",
    "clean:bundles": "rm -rf bundles",
    "build": "pnpm clean && pnpm build:esm && pnpm build:cjs && pnpm build:docs",
    "build:esm": "tsc -p tsconfig.json",
    "build:cjs": "tsc -p tsconfig.cjs.json && echo '{\"type\":\"commonjs\"}' > dist/cjs/package.json",
    "build:bundles": "pnpm clean:bundles && tsdown",
    "build:all": "pnpm build && pnpm build:bundles && pnpm sizes",
    "build:docs": "typedoc",
    "format": "npx biome format --write src",
    "test": "pnpm test:types && vitest",
    "sizes": "bundle-size",
    "prepublishOnly": "npm run build",
    "test:types": "tsc --ignoreConfig --noEmit --types node --strict --skipLibCheck --noUncheckedIndexedAccess --exactOptionalPropertyTypes --target ESNext --module ESNext --moduleResolution Bundler src/type-safety.test.ts src/config.integration.test.ts src/intellisense.integration.test.ts src/readme.test.ts && tsc -p examples/tsconfig.json",
    "test:run": "pnpm test:types && vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm test:types",
    "typecheck:examples": "tsc -p examples/tsconfig.json"
  },
  "dependencies": {
    "@fimbul-works/hvat": "^1.3.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@fimbul-works/bundle-size": "^2.0.0",
    "@types/node": "^26.6.6",
    "tsdown": "^0.23.5",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.14.1",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
